      <column caption='Price flexibility' datatype='real' name='[Calculation_1376596259532800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Volume Variance]) / AVG([Price per Unit Variance])' />
      </column>
      <column caption='Rank by Dollars' datatype='integer' name='[Calculation_1376596263464961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Dollars Current Year]), &apos;asc&apos;)'>
